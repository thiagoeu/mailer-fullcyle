# ==========================================
# CONFIGURAÇÕES GERAIS DA APLICAÇÃO
# ==========================================
NODE_ENV=development
PORT=3333
ADMIN_MASTER_KEY=master_admin_secret
API_SECRET_KEY=default_secret_key

# ==========================================
# BANCO DE DADOS (TypeORM / PostgreSQL 16)
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=mailer_user
DB_PASSWORD=mailer_password
DB_NAME=mailer_db

# ==========================================
# FILA ASSÍNCRONA (BullMQ / Redis 7)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ==========================================
# PROVEDOR DE E-MAIL
# Valores aceitos: 'gmail' (produção/real) ou 'mailpit' (dev local)
# ==========================================
MAIL_PROVIDER=gmail

# Credenciais Google SMTP (Requer 2FA e Senha de Aplicativo de 16 letras gerada no Google)
GOOGLE_ACCOUNT_USER="seu-email@gmail.com"
GOOGLE_ACCOUNT_PASSWORD="sua-senha-de-aplicativo"
EMAIL_FROM_DEFAULT="seu-email@gmail.com"

# Servidor SMTP Mock Local (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ==========================================
# OBSERVABILIDADE (Prometheus & Grafana)
# ==========================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
