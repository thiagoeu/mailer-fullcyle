# ==========================================
# CONFIGURAÇÕES DE TESTE (ISOLADAS)
# ==========================================
NODE_ENV=test
PORT=3334
ADMIN_MASTER_KEY=master_admin_secret
API_SECRET_KEY=default_secret_key

# ==========================================
# BANCO DE DADOS DEDICADO DE TESTE
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=mailer_user
DB_PASSWORD=mailer_password
DB_NAME=mailer_db_test

# ==========================================
# FILA ASSÍNCRONA (REDIS)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ==========================================
# PROVEDOR DE E-MAIL (MAILPIT - ZERO DISPARO REAL)
# ==========================================
MAIL_PROVIDER=mailpit
EMAIL_FROM_DEFAULT=test@mailer.local
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ==========================================
# OBSERVABILIDADE
# ==========================================
PROMETHEUS_PORT=9091
GRAFANA_PORT=3001

